{
  "name": "webcapturer",
  "version": "1.0.0",
  "description": "Local multi-camera recorder built with Electron + TypeScript",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy:html",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy:html": "node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/renderer',{recursive:true}); fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "keywords": [
    "electron",
    "typescript",
    "camera",
    "recorder"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.18",
    "electron": "^31.7.7",
    "typescript": "^5.6.3"
  }
}
